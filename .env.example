# Deployed customer website URL (no trailing slash)
VITE_SITE_URL=https://localpintu.com

# Public HTTPS backend endpoints
VITE_API_BASE_URL=https://api.localpintu.com/api
VITE_SOCKET_URL=https://api.localpintu.com
VITE_TECHNICIAN_PANEL_URL=https://technician.localpintu.com

# Required for premise/building/road-level browser reverse geocoding.
# Restrict this browser key to the production and Netlify frontend domains.
VITE_GOOGLE_MAPS_API_KEY=

# Optional analytics and search-engine ownership IDs
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
